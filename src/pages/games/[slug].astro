---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  return (await getCollection('games')).map((game) => ({ params: { slug: game.id }, props: { game } }));
}
const { game } = Astro.props;
const { Content } = await render(game);
const d = game.data;
---
<Base title={d.title}>
  <h1 class="title">
    {d.logo ? <img class="logo" src={d.logo} alt={d.title} /> : d.title}
  </h1>
  <div class="meta">
    <span><strong data-count={`/api/hit/downloads/${game.id}`} data-base={d.baseDownloads}>{d.baseDownloads.toLocaleString()}</strong> تحميل</span>
    <span>إصدار التعريب: <strong>{d.version}</strong></span>
    <span>المنصة: <strong>{d.platform}</strong></span>
    <span>تاريخ نزول التعريب: <strong>{new Date(d.publish).toLocaleDateString('en-US')}</strong></span>
    <span>أخر تحديث: <strong>{new Date(d.update).toLocaleDateString('en-US')}</strong></span>
  </div>
  <a class="btn cut" href={`/api/download/${game.id}`}>حمل التعريب</a>

  <div class="prose" style="margin-top:2rem"><Content /></div>

  <h2>اللي عملته</h2>
  <div class="panel cut"><ul class="list">{d.translated.map((item) => <li>{item}</li>)}</ul></div>

  <h2>فيديو تفاصيل التعريب وإزاي أثبته</h2>
  <iframe class="video cut" title={`الفيديو`} loading="lazy"
    src={`https://www.youtube-nocookie.com/embed/${d.youtube}`}
    allow="accelerometer; encrypted-media; picture-in-picture" allowfullscreen></iframe>
</Base>
